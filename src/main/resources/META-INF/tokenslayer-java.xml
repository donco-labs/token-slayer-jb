<!--
  Java language support. Loaded ONLY when the Java module (com.intellij.modules.java)
  is present — i.e. in IntelliJ IDEA, not in PyCharm/WebStorm/GoLand. Keeping the
  Java inlay registration here (rather than in the core plugin.xml) is what allows
  the plugin to load in IDEs that do not bundle Java.
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider
            language="JAVA"
            providerId="tokenslayer.hints"
            implementationClass="com.tokenslayer.ui.inlay.TokenSlayerInlayProvider"
            isEnabledByDefault="true"
            group="OTHER_GROUP"
            bundle="messages.TokenSlayerBundle"
            nameKey="inlay.tokenslayer.name"
            descriptionKey="inlay.tokenslayer.description"/>
    </extensions>
</idea-plugin>
